        when hour(e.ts) >= 6 and hour(e.ts) < 14 then 'A'
        when hour(e.ts) >= 14 and hour(e.ts) < 22 then 'B'
        else 'C'
    end as shift
from "steel"."main"."stg_energy" e
join "steel"."main"."stg_production" p on e.ts = p.ts
    );
    
  
